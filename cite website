session_start();

$servername = "localhost";
$username   = "root";
$password   = "";
$dbname     = "school_db";

$conn = new mysqli($servername, $username, $password, $dbname);

if ($conn->connect_error) {
    die("Database connection failed: " . $conn->connect_error);
}

$conn->set_charset("utf8mb4");


/* =========================================================
   MESSAGES
   ========================================================= */

$login_message = "";
$register_message = "";
$register_success = "";


/* =========================================================
   LOGOUT
   ========================================================= */

if (isset($_GET["logout"])) {

    session_unset();
    session_destroy();

    header("Location: index.php");
    exit;
}


/* =========================================================
   REGISTER
   ========================================================= */

if (isset($_POST["register"])) {

    $student_number = trim($_POST["student_number"] ?? "");
    $lastname       = trim($_POST["lastname"] ?? "");
    $firstname      = trim($_POST["firstname"] ?? "");
    $middlename     = trim($_POST["middlename"] ?? "");
    $program        = trim($_POST["program"] ?? "");
    $email          = trim($_POST["email"] ?? "");
    $password       = $_POST["password"] ?? "";
    $confirm        = $_POST["confirm_password"] ?? "";


    /* Check password */
    if ($password !== $confirm) {

        $register_message = "Passwords do not match.";

    } else {

        /* Check if email already exists */

        $check = $conn->prepare(
            $sql = "SELECT id FROM users WHERE LOWER(email) = LOWER(?) LIMIT 1";
$check = $conn->prepare($sql);

if ($check === false) {
    die("Database Error: " . $conn->error);
}

$check->bind_param("s", $email);


        if ($check->num_rows > 0) {

            $register_message =
                "An account with that email already exists.";

        } else {

            /* Hash password */

            $hashed_password = password_hash(
                $password,
                PASSWORD_DEFAULT
            );


            /* Insert user */

            $stmt = $conn->prepare(
                "INSERT INTO users
                (student_number, lastname, firstname, middlename, program, email, password)
                VALUES (?, ?, ?, ?, ?, ?, ?)"
            );

            $stmt->bind_param(
                "sssssss",
                $student_number,
                $lastname,
                $firstname,
                $middlename,
                $program,
                $email,
                $hashed_password
            );


            if ($stmt->execute()) {

                $register_success =
                    "Account created successfully. You can now log in.";

            } else {

                $register_message =
                    "Registration failed: " . $stmt->error;
            }

            $stmt->close();
        }

        $check->close();
    }
}


/* =========================================================
   LOGIN
   ========================================================= */

if (isset($_POST["login"])) {

    $email    = trim($_POST["email"] ?? "");
    $password = $_POST["password"] ?? "";


    $stmt = $conn->prepare(
        "SELECT
            id,
            student_number,
            lastname,
            firstname,
            middlename,
            program,
            email,
            password
         FROM users
         WHERE LOWER(email) = LOWER(?)
         LIMIT 1"
    );

    $stmt->bind_param("s", $email);
    $stmt->execute();

    $result = $stmt->get_result();


    if ($result->num_rows === 1) {

        $user = $result->fetch_assoc();


        if (password_verify($password, $user["password"])) {

            $_SESSION["user_id"]        = $user["id"];
            $_SESSION["email"]          = $user["email"];
            $_SESSION["student_number"] = $user["student_number"];
            $_SESSION["lastname"]       = $user["lastname"];
            $_SESSION["firstname"]      = $user["firstname"];
            $_SESSION["middlename"]     = $user["middlename"];
            $_SESSION["program"]        = $user["program"];


            header("Location: index.php");
            exit;

        } else {

            $login_message = "Incorrect email or password.";
        }

    } else {

        $login_message = "Incorrect email or password.";
    }

    $stmt->close();
}


/* =========================================================
   EDIT PROFILE
   ========================================================= */

if (
    isset($_POST["update_profile"]) &&
    isset($_SESSION["user_id"])
) {

    $user_id = $_SESSION["user_id"];

    $firstname  = trim($_POST["edit_firstname"] ?? "");
    $middlename = trim($_POST["edit_middlename"] ?? "");
    $lastname   = trim($_POST["edit_lastname"] ?? "");
    $program    = trim($_POST["edit_program"] ?? "");


    $stmt = $conn->prepare(
        "UPDATE users
         SET firstname = ?,
             middlename = ?,
             lastname = ?,
             program = ?
         WHERE id = ?"
    );

    $stmt->bind_param(
        "ssssi",
        $firstname,
        $middlename,
        $lastname,
        $program,
        $user_id
    );


    if ($stmt->execute()) {

        $_SESSION["firstname"]  = $firstname;
        $_SESSION["middlename"] = $middlename;
        $_SESSION["lastname"]   = $lastname;
        $_SESSION["program"]    = $program;
    }


    $stmt->close();

    header("Location: index.php#profile");
    exit;
}


